"kind": "size", "value": "14 mm", "unit": "mm", "page": 83, "quote": "Remove the oil filter cover by using 14 mm Allen key"}, {"sectionId": "oil-filter-replacement", "name": "Oil filter cover tightening torque", "kind": "torque", "value": "22±2 Nm", "unit": "Nm", "page": 83, "quote": "Install the cover and tighten to 22±2 Nm, ensuring spring is retained in the cover."}, {"sectionId": "coolant-draining", "name": "Coolant drain bolt tightening torque", "kind": "torque", "value": "11±1 Nm", "unit": "Nm", "page": 84, "quote": "Once drained, then replace the copper washer with a new part and tighten bolt to 11±1 Nm."}, {"sectionId": "tyre-pressure", "name": "Tyre pressure", "kind": "pressure", "value": "32 psi/2.24 kg/cm2 psi/kg/cm2", "unit": "psi/kg/cm2", "page": 88, "quote": "Front & Rear Solo & With Pillion 32 psi/2.24 kg/cm2"}, {"sectionId": "front-wheel-removal", "name": "Front wheel ground clearance", "kind": "clearance", "value": "15 cm", "unit": "cm", "page": 89, "quote": "Locate a scissor jack under the engine and lift motorcycle such that the front wheel is off the ground by minimum 15 cm."}, {"sectionId": "front-wheel-removal", "name": "Allen key", "kind": "size", "value": "6 mm", "unit": "mm", "page": 89, "quote": "Loosen and remove fork clamp bolt 2 Nos from RHS front fork assembly by using 6 mm Allen key available in the tool kit."}, {"sectionId": "front-wheel-assembly", "name": "Fork clamp bolt torque", "kind": "torque", "value": "25 Nm", "unit": "Nm", "page": 92, "quote": "Tighten fork clamp bolt firmly on RH side to a torque of 25 Nm."}, {"sectionId": "rear-wheel-removal", "name": "24 mm", "kind": "size", "value": "24 mm", "unit": "mm", "page": 94, "quote": "Loosen the lock nuts and adjuster nuts fully on the left and right side chain adjuster by using 24 mm ring spanner available in the tool kit."}, {"sectionId": "rear-wheel-removal", "name": "wooden piece", "kind": "size", "value": "4 mm", "unit": "mm", "page": 96, "quote": "Place a 4 mm thick wooden piece or cardboard sheet between the brake pads to avoid activation of brake pads if rear brake pedal is accidentally pressed."}, {"sectionId": "clutch-cable-free-play-inspection-adjustment", "name": "Adjusting spanner size", "kind": "size", "value": "12 mm", "unit": "mm", "page": 99, "quote": "Using a 12 mm spanner, loosen the adjusting nut closest to the lifter arm fully and measuring the instrument."}, {"sectionId": "clutch-cable-free-play-inspection-adjustment", "name": "Clutch lever free play", "kind": "clearance", "value": "9 - 11 mm", "unit": "mm", "page": 99, "quote": "Adjust the position of the inner adjusting nut to provide 9 - 11 mm of free play in the clutch lever ball end (from its furthest position) before engine engagement."}, {"sectionId": "drive-chain-tension-free-play-35-40-mm", "name": "Drive chain free play", "kind": "clearance", "value": "35 - 40 mm", "unit": "mm", "page": 101, "quote": "6.The difference between values in step 4 and step 5 should be the drive chain free play is 35 to 40 mm."}, {"sectionId": "drive-chain-tension-free-play-35-40-mm", "name": "Wheel spindle torque value", "kind": "torque", "value": "70 Nm", "unit": "Nm", "page": 101, "quote": "(d) Tighten the wheel spindle torque value is 70 Nm and tighten the adjusting Allen bolt torque value is 10 Nm."}, {"sectionId": "drive-chain-tension-free-play-35-40-mm", "name": "Adjusting Allen bolt torque value", "kind": "torque", "value": "10 Nm", "unit": "Nm", "page": 101, "quote": "(d) Tighten the wheel spindle torque value is 70 Nm and tighten the adjusting Allen bolt torque value is 10 Nm."}, {"sectionId": "battery-maintenance", "name": "Battery", "kind": "electrical", "value": "12 V - 8 Ah VRLA", "page": 102, "quote": "The motorcycle is provided with 12 V - 8 Ah VRLA battery."}, {"sectionId": "mini-blade-fuse-usage-list", "name": "F1", "kind": "electrical", "value": "15 A", "unit": "A", "page": 110, "quote": "F1 Blue 15 A Ignition"}, {"sectionId": "mini-blade-fuse-usage-list", "name":