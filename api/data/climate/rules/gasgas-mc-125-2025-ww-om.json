, {"id": "07b2c74d32ed", "manualId": "gasgas-mc-125-2025-ww-om", "ruleType": "cold_start", "name": "Cold-start procedure for lithium-ion batteries", "comparator": "below", "thresholdC": 15.0, "value": "Press the start button for 5 seconds, and wait 30 seconds be", "page": 22, "quote": "At low temperatures, however, the starting power of lithium-ion batteries drops to below that of lead batteries. Several attempts to start may be required. Press the start button for 5 seconds, and wait 30 seconds between attempts.", "source": "model"}, {"id": "f910bb690cbd", "manualId": "gasgas-mc-125-2025-ww-om", "ruleType": "cold_start", "name": "cold_start", "comparator": "below", "thresholdC": 20.0, "value": "Press the cold start button", "page": 27, "quote": "Condition: Ambient temperature: < 20 °C", "source": "model"}, {"id": "ec5e979baf9c", "manualId": "gasgas-mc-125-2025-ww-om", "ruleType": "cold_start", "name": "12 V battery recharge interval", "comparator": "always", "value": "3 months", "page": 106, "quote": "Recharge the 12 V battery regu- larly when the motorcycle is not being used. 3 months", "source": "model"}]