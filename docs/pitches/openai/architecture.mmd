---
title: "Mechanica — every OpenAI call, and the guardrail that catches it"
---
flowchart LR

%% ============================================================
%% COLUMN 1 — what the mechanic does
%% ============================================================
subgraph IN["WHAT THE MECHANIC DOES"]
    direction TB
    S1["Photo of the bike"]
    S2["VIN"]
    S3["A bike nobody<br/>has asked for yet"]
    S4["One sentence:<br/>chain is baggy"]
    S5["Taps a part"]
end

%% ============================================================
%% COLUMN 2 — our deterministic backend
%% ============================================================
subgraph DET["OUR BACKEND — DETERMINISTIC, NO TOKENS"]
    direction TB
    D0["400 catalog names<br/>injected into the prompt"]
    D1["NHTSA vPIC decode<br/>no model call at all"]
    D2["PyMuPDF text layer<br/>+ per-block coordinates"]
    D3["BM25 over the manual's<br/>own printed headings"]
    D4["SPEC PATH: parsed spec rows<br/>answer with ZERO LLM<br/>$0.00013 · 1.5 s"]
    D5["at most 6 printed pages<br/>dealer boilerplate stripped<br/>bear-2 compression, -31%"]
    D6["query from what the manual<br/>PRINTED: OEM no. or spec<br/>+ make / model / year"]
end

%% ============================================================
%% COLUMN 3 — THE HEART
%% ============================================================
subgraph OAI["app/llm.py — ONE DOOR TO OPENAI · every call logs route · model · tokens · cached · USD"]
    direction TB
    A1["identify.photo · VISION<br/>gpt-5.6-luna · strict json_schema<br/>make · model · generation · kind<br/>· cues · alternatives<br/><b>$0.00046 per photo</b>"]
    A2["ingest.struct<br/>gpt-5.6-luna · strict json_schema<br/>5-page windows · 32 workers<br/>units · specs · parts · quotes<br/><b>47% of 70.4M tokens cached</b>"]
    A3["ingest.keywords<br/>gpt-5.6-luna · strict json_schema<br/>the slang a rider would say<br/>for every printed heading"]
    A4["ask.router<br/>gpt-5.6-luna · strict json_schema<br/>slang · typos · DE/ES/FR<br/>into manual English<br/><b>99.5% prompt-cache hit · $0.00013</b>"]
    A5["ask.picker<br/>gpt-5.6-terra · strict json_schema<br/><b>RETURNS IDS ONLY — never prose</b><br/>35% cached · $0.0022"]
    A6["chat.answer<br/>gpt-5.6-terra · <b>STREAMING</b><br/>prompt_cache_key pinned per route<br/>may only emit [p. N]<br/><b>43% cached · first token 2.6 s</b>"]
    A7["offers · gpt-5.6-terra<br/><b>BUILT-IN web_search TOOL</b><br/>context low · max_tool_calls 2<br/>fitment-exact, one line per offer"]
    A8["gpt-image-1<br/>97 part illustrations + the logo<br/>one style prompt, one camera<br/><b>$0.042 each</b>"]
    A9["images.score · VISION AS JUDGE<br/>gpt-5.6-luna · strict json_schema<br/>grades every catalog photo<br/><b>4,136 calls · $2.04</b>"]
end

%% ============================================================
%% COLUMN 4 — the guardrails
%% ============================================================
subgraph GRD["THE GUARDRAIL THAT CATCHES IT"]
    direction TB
    G1["match back to a real catalog row<br/>floor 0.80 — a bike we hold no<br/>manual for cannot win"]
    G2["ground.py: every quote is searched<br/>for in the PDF text layer.<br/><b>Not found = dropped.</b>"]
    G3["id allowlist: an id that was not in<br/>the candidate list is dropped.<br/><b>A hallucinated section never ships.</b>"]
    G4["the MODEL names a page,<br/>the SERVER slices the quote out<br/>of the ORIGINAL page text.<br/><b>100% of 43 citations verbatim</b>"]
    G5["every digit must be printed on a<br/>page it was given.<br/><b>0 invented numbers in 25 answers</b>"]
    G6["price must survive a regex on the<br/>model's own text; every URL is<br/>HEAD-fetched; FX done in Python"]
end

%% ============================================================
%% COLUMN 5 — what ships
%% ============================================================
subgraph OUT["WHAT THE MECHANIC GETS"]
    direction TB
    R1["the exact bike"]
    R2["searchable manual<br/>readable in 7 s · indexed in 50 s<br/><b>$0.10, once, forever</b>"]
    R3["THE OEM PAGE, lines marked<br/>3D model exploded on the part<br/>p95 3.33 s · <b>$0.00038</b>"]
    R4["an answer where every sentence<br/>carries a [p. N] chip that jumps<br/>to that page"]
    R5["exact-fit parts, live prices,<br/>cheapest first"]
end

%% ---------------- wiring ----------------
S1 --> D0 --> A1 --> G1 --> R1
S2 --> D1 --> R1
S3 --> D2 --> A2 --> G2 --> R2
D2 --> A3 --> R2
S4 --> A4
A4 -- "intent = spec" --> D4 --> R3
A4 -- "else" --> D3
D3 -- "top-2 margin decisive" --> R3
D3 -- "ambiguous" --> A5 --> G3 --> R3
S4 --> D5 --> A6 --> G4 --> G5 --> R4
S5 --> D6 --> A7 --> G6 --> R5
A8 --> R5
A9 --> R1
R2 -.-> D3
R2 -.-> D4
R2 -.-> D5

VO["the voice agent thinks with an OpenAI model<br/>through Deepgram, and may ONLY call our grounded tools:<br/>find_procedure · read_page · get_spec · list_parts — first audio 0.7-2.0 s"]
NO["HONEST ABOUT WHAT WE DO NOT USE:<br/>no fine-tuning · no Batch API · no Assistants API<br/>no embeddings and no vector store in the live path"]
S4 -.-> VO
VO -.-> A4

