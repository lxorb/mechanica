{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trustthemanual",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  // Keep the workers.dev URL alive alongside the custom domain.
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "mechanica.emilvinu.ch", "custom_domain": true }
  ],
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything except /api/* is served straight from web/ without invoking the Worker.
    "run_worker_first": ["/api/*"]
  }
}
